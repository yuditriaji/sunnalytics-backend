generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TokenHeader {
  id        String   @id // CoinGecko ID (e.g., "0x")
  symbol    String   // e.g., "ZRX"
  name      String   // e.g., "0x Protocol"
  platforms Json     // e.g., { "ethereum": "0xe41d2489571d322189246dafa5ebde1f4699f498" }
  exchange  String?  // Comma-separated exchanges (e.g., "binance,bybit,mexc,htx,gate")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tokenDetail TokenDetail?
}

model TokenDetail {
  id                    String   @id // CoinGecko ID (e.g., "0x")
  symbol                String   // e.g., "ZRX"
  platform              String   // e.g., "solana", "ethereum"
  contractAddress       String   // e.g., "0xe41d2489571d322189246dafa5ebde1f4699f498"
  walletDistributionScore Float?   // e.g., 80
  poolLiquidity         Float?   // e.g., 500000 (USD, Solana only)
  txActivityScore       Float?   // e.g., 75 (Solana only)
  transferVolume24h     Float?   // e.g., 1000000 (USD, Bitquery)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  tokenHeader          TokenHeader? @relation(fields: [id], references: [id])
}

model Token {
  id                    String        @id @default(uuid())
  name                  String
  symbol                String        @unique
  category              String
  price                 Float?
  marketCap             Float?
  volume24h             Float?
  priceChange24h        Float?
  transferVolume24h     Float?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  histories             TokenHistory[]
  exchanges             TokenExchange[]
  liquidityScore        Float?
  pumpDumpRiskScore     Float?
  walletDistributionScore Float?
  contractAddress       String?       // From TokenHeader.platforms
  platform              String?       // e.g., "solana", "ethereum"
  exchange              String?       // Comma-separated exchanges (e.g., "binance,bybit,mexc,htx,gate")
  @@index([symbol])
  @@index([exchange])
}

model TokenHistory {
  id          String   @id @default(uuid())
  tokenId     String
  price       Float?
  marketCap   Float?
  volume24h   Float?
  timestamp   DateTime @default(now())
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  @@index([tokenId, timestamp])
}

model TokenExchange {
  id          Int      @id @default(autoincrement())
  tokenId     String
  exchange    String   // e.g., "binance", "bybit", "mexc", "htx", "gate"
  symbol      String
  lastPrice   Float?
  volume      Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  token       Token    @relation(fields: [tokenId], references: [id], onDelete: Cascade)
  @@unique([tokenId, exchange])
  @@index([symbol])
  @@index([exchange])
}
