# Sunnalytics Backend Environment Variables

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL="postgresql://user:password@localhost:5432/sunnalytics"

# =============================================================================
# TIER 1: DIRECT ON-CHAIN DATA (Recommended)
# =============================================================================

# Helius - Solana RPC + DAS API (https://helius.dev)
# Free: 10K requests/day, Growth: $49/mo
HELIUS_API_KEY="your-helius-api-key"
# Use Helius RPC for better Solana data
SOLANA_RPC_URL="https://mainnet.helius-rpc.com/?api-key=your-helius-api-key"

# Moralis - Multi-chain EVM (https://moralis.io)
# Free: 40K CU/day, Pro: $49/mo
MORALIS_API_KEY="your-moralis-api-key"

# =============================================================================
# TIER 2: DEX DATA
# =============================================================================

# Birdeye - Solana DEX analytics (https://birdeye.so)
# Free tier available, Pro: $99/mo
BIRDEYE_API_KEY="your-birdeye-api-key"

# Jupiter - Solana price API (free, no key required)
# https://price.jup.ag

# DEXScreener - Multi-chain DEX data (free, no key required)  
# https://api.dexscreener.com

# =============================================================================
# TIER 3: AGGREGATORS (Fallback)
# =============================================================================

# CoinGecko - Market data (https://coingecko.com)
# Free: 10K calls/mo, Demo: $129/mo
COINGECKO_API_KEY="your-coingecko-api-key"

# CoinMarketCap - Alternative market data
# CMC_API_KEY="your-cmc-api-key"

# =============================================================================
# EVM CHAIN RPCs (Optional - Moralis handles most of this)
# =============================================================================

# Use free public RPCs or get premium from:
# - Alchemy (https://alchemy.com)
# - Infura (https://infura.io)
# - QuickNode (https://quicknode.com)

ETH_RPC_URL="https://eth.llamarpc.com"
BSC_RPC_URL="https://bsc-dataseed.binance.org"
BASE_RPC_URL="https://mainnet.base.org"
ARBITRUM_RPC_URL="https://arb1.arbitrum.io/rpc"

# =============================================================================
# LEGACY (from existing setup)
# =============================================================================

# Etherscan - Ethereum block explorer API
ETHERSCAN_API_KEY="your-etherscan-api-key"

# QuickNode - Alternative Solana RPC
QUICKNODE_URL="your-quicknode-url"

# =============================================================================
# SERVER CONFIG
# =============================================================================

PORT=3001
NODE_ENV=development
CORS_ORIGINS="http://localhost:3000,https://sunnalytics.vercel.app"

# =============================================================================
# FUTURE: REAL-TIME & SOCIAL (Post-MVP)
# =============================================================================

# Redis for caching and pub/sub (real-time features)
# REDIS_URL="redis://localhost:6379"

# LunarCrush - Social metrics
# LUNARCRUSH_API_KEY="your-lunarcrush-api-key"

# Santiment - On-chain + social
# SANTIMENT_API_KEY="your-santiment-api-key"
